# ThreatStream Frontend Environment Configuration

# Alert Service REST API base URL (default: http://localhost:8083)
VITE_ALERT_API_BASE_URL=http://localhost:8083

# Generic backend API base URL fallback
VITE_API_BASE_URL=http://localhost:8084

# Polling interval for live SOC telemetry refresh in milliseconds (min: 5000)
VITE_ALERT_POLL_INTERVAL_MS=30000

# Optional API key for authenticating with Alert Service (when ALERT_SERVICE_API_KEY is configured).
# Note: VITE_ variables are bundled into client-side JS; never put server private keys or database passwords here.
VITE_API_KEY=your-client-api-key-here

