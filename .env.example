# Copy to .env for local Docker Compose development. Do not use these values in production.
POSTGRES_DB=threatstream
POSTGRES_USER=threatstream_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Host-run applications use localhost:9094; Compose services use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_AUTH_EVENTS=security.auth.events
KAFKA_TOPIC_NETWORK_EVENTS=security.network.events
NETWORK_MAX_TRACKED_KEYS=10000
PORT_SCAN_THRESHOLD=20
PORT_SCAN_WINDOW=PT60S
PORT_SCAN_COOLDOWN=PT60S
DOS_BYTES_PER_SECOND=10000000
DOS_PACKETS_PER_SECOND=10000
DOS_WINDOW=PT60S
DOS_COOLDOWN=PT60S
DDOS_BYTES_PER_SECOND=20000000
DDOS_SOURCE_THRESHOLD=5
DDOS_WINDOW=PT60S
DDOS_COOLDOWN=PT60S
KAFKA_TOPIC_ALERTS=security.alerts
KAFKA_TOPIC_DLT=security.events.dlt

# Demo-only login. Set a local value in .env; never use a real password.
DEMO_LOGIN_USERNAME=demo-user
DEMO_LOGIN_PASSWORD=replace-with-a-local-demo-password

# Browser API endpoint when running the Vite frontend locally.
VITE_API_BASE_URL=http://localhost:8084
VITE_ALERT_API_BASE_URL=http://localhost:8083
VITE_ALERT_POLL_INTERVAL_MS=30000
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Detection demonstration defaults; values are ISO-8601 durations.
KAFKA_DETECTION_GROUP_ID=threat-detection-service-v1
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW=PT60S
PASSWORD_SPRAYING_THRESHOLD=10
PASSWORD_SPRAYING_WINDOW=PT120S
SUSPICIOUS_LOGIN_THRESHOLD=5
SUSPICIOUS_LOGIN_WINDOW=PT5M
DETECTION_DEDUP_RETENTION=PT10M
KAFKA_RETRY_ATTEMPTS=3
KAFKA_ALERT_GROUP_ID=alert-service-v1

# MongoDB Atlas — alert-service persistence.
# Replace with your own Atlas connection string. Do NOT commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=threatstream

# CIC-IDS2017 replay (host-run processor connects to localhost Kafka).
KAFKA_TOPIC_NETWORK_EVENTS=security.network.events
